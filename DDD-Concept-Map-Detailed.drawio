<mxfile host="drawio" version="29.3.6"><diagram name="DDD Detailed Concept Map" id="ddd-detailed"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3260" pageHeight="3185" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b style=&quot;font-size:34px&quot;&gt;Domain-Driven Design&lt;/b&gt;&lt;span style=&quot;font-size:22px;color:#6b7280&quot;&gt;  —  The Complete Concept Map&lt;/span&gt;" style="fontFamily=Helvetica;text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1600" height="50" as="geometry"/></mxCell><mxCell id="subtitle" value="From understanding the business to running software: how every DDD idea connects. Read the stages &lt;b&gt;top to bottom&lt;/b&gt;; read each arrow as a sentence, e.g. &lt;i&gt;Aggregate Root &lt;b&gt;→ enforces →&lt;/b&gt; Invariants&lt;/i&gt;." style="fontFamily=Helvetica;text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="40" y="72" width="1900" height="30" as="geometry"/></mxCell><mxCell id="band1" value="" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#faf7fd;strokeColor=#8e6bbf;arcSize=2;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="3055" height="367" as="geometry"/></mxCell><mxCell id="tile1" value="&lt;div style=&quot;font-size:54px;font-weight:bold;opacity:0.9&quot;&gt;1&lt;/div&gt;&lt;div style=&quot;font-size:21px;font-weight:bold;margin-top:4px&quot;&gt;Discover &amp;amp; Understand&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-style:italic;margin-top:10px&quot;&gt;What does the business do, and how do the experts talk about it?&lt;/div&gt;&lt;div style=&quot;font-size:12px;margin-top:14px;text-align:left&quot;&gt;• Model together with domain experts&lt;br&gt;• Learn continuously&lt;br&gt;• Forge one shared language&lt;/div&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#8e6bbf;strokeColor=#8e6bbf;fontColor=#ffffff;arcSize=4;spacing=18;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="300" height="367" as="geometry"/></mxCell><mxCell id="experts" value="&lt;b style=&quot;font-size:14px&quot;&gt;Domain Experts&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;People with deep knowledge of how the business really works&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#f1eafa;strokeColor=#8e6bbf;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="400" y="220" width="240" height="92" as="geometry"/></mxCell><mxCell id="devs" value="&lt;b style=&quot;font-size:14px&quot;&gt;Development Team&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Engineers who will turn the model into working software&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#f1eafa;strokeColor=#8e6bbf;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="400" y="370" width="240" height="92" as="geometry"/></mxCell><mxCell id="kc" value="&lt;b style=&quot;font-size:14px&quot;&gt;Knowledge Crunching&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Collaborative, continuous learning that distills what matters&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#f1eafa;strokeColor=#8e6bbf;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="745" y="295.0" width="240" height="92" as="geometry"/></mxCell><mxCell id="fTech" value="&lt;b&gt;Collaborative Modeling Techniques&lt;/b&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8e6bbf;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;fontSize=13;fontColor=#4c2f7a;arcSize=5;" vertex="1" parent="1"><mxGeometry x="1072" y="186" width="966" height="294" as="geometry"/></mxCell><mxCell id="esBig" value="&lt;b style=&quot;font-size:14px&quot;&gt;Event Storming · Big Picture&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Map the whole business flow as orange sticky-note domain events&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#f1eafa;strokeColor=#8e6bbf;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="1090" y="220" width="240" height="92" as="geometry"/></mxCell><mxCell id="esProc" value="&lt;b style=&quot;font-size:14px&quot;&gt;Event Storming · Process&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Add commands, actors, policies and read models per process&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#f1eafa;strokeColor=#8e6bbf;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="1435" y="220" width="240" height="92" as="geometry"/></mxCell><mxCell id="esDesign" value="&lt;b style=&quot;font-size:14px&quot;&gt;Event Storming · Design&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Group events &amp;amp; commands into aggregates and boundaries&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#f1eafa;strokeColor=#8e6bbf;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="1780" y="220" width="240" height="92" as="geometry"/></mxCell><mxCell id="dStory" value="&lt;b style=&quot;font-size:14px&quot;&gt;Domain Storytelling&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Experts narrate real work as pictographic stories&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#f1eafa;strokeColor=#8e6bbf;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="1090" y="370" width="240" height="92" as="geometry"/></mxCell><mxCell id="exMap" value="&lt;b style=&quot;font-size:14px&quot;&gt;Example Mapping&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Concrete examples expose business rules &amp;amp; edge cases&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#f1eafa;strokeColor=#8e6bbf;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="1435" y="370" width="240" height="92" as="geometry"/></mxCell><mxCell id="whirl" value="&lt;b style=&quot;font-size:14px&quot;&gt;Model Exploration Whirlpool&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Scenario → model → code probe → challenge, then repeat&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#f1eafa;strokeColor=#8e6bbf;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="1780" y="370" width="240" height="92" as="geometry"/></mxCell><mxCell id="ul" value="&lt;b style=&quot;font-size:14px&quot;&gt;Ubiquitous Language&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;One rigorous vocabulary used in speech, docs, tests and code&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#f1eafa;strokeColor=#8e6bbf;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="2125" y="220" width="240" height="92" as="geometry"/></mxCell><mxCell id="dm" value="&lt;b style=&quot;font-size:14px&quot;&gt;Domain Model&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;A focused abstraction of the domain built to solve the problem&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#f1eafa;strokeColor=#8e6bbf;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="2125" y="370" width="240" height="92" as="geometry"/></mxCell><mxCell id="mdd" value="&lt;b style=&quot;font-size:14px&quot;&gt;Model-Driven Design&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Code mirrors the model: change one and you change the other&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#f1eafa;strokeColor=#8e6bbf;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="2470" y="295.0" width="240" height="92" as="geometry"/></mxCell><mxCell id="hands" value="&lt;b style=&quot;font-size:14px&quot;&gt;Hands-on Modelers&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Modelers code and coders model; no hand-off of the model&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#f1eafa;strokeColor=#8e6bbf;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="2815" y="295.0" width="240" height="92" as="geometry"/></mxCell><mxCell id="edge1" value="collaborate in" style="fontFamily=Helvetica;html=1;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#4c2f7a;fontColor=#4c2f7a;exitX=1;exitY=0.5000;entryX=0;entryY=-0.3152;" edge="1" parent="1" source="experts" target="kc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge2" value="collaborate in" style="fontFamily=Helvetica;html=1;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#4c2f7a;fontColor=#4c2f7a;exitX=1;exitY=0.5000;entryX=0;entryY=1.3152;" edge="1" parent="1" source="devs" target="kc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge3" value="using" style="fontFamily=Helvetica;html=1;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#4c2f7a;fontColor=#4c2f7a;exitX=1;exitY=0.5000;entryX=0;entryY=0.5272;" edge="1" parent="1" source="kc" target="fTech"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge4" value="zoom in" style="fontFamily=Helvetica;html=1;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#4c2f7a;fontColor=#4c2f7a;exitX=1;exitY=0.5000;entryX=0;entryY=0.5000;" edge="1" parent="1" source="esBig" target="esProc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge5" value="zoom in" style="fontFamily=Helvetica;html=1;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#4c2f7a;fontColor=#4c2f7a;exitX=1;exitY=0.5000;entryX=0;entryY=0.5000;" edge="1" parent="1" source="esProc" target="esDesign"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge6" value="forges" style="fontFamily=Helvetica;html=1;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#4c2f7a;fontColor=#4c2f7a;exitX=1;exitY=0.2721;entryX=0;entryY=0.5000;" edge="1" parent="1" source="fTech" target="ul"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge7" value="produces" style="fontFamily=Helvetica;html=1;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#4c2f7a;fontColor=#4c2f7a;exitX=1;exitY=0.7823;entryX=0;entryY=0.5000;" edge="1" parent="1" source="fTech" target="dm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge8" value="is the language of" style="fontFamily=Helvetica;html=1;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#4c2f7a;fontColor=#4c2f7a;exitY=1;exitX=0.5000;entryY=0;entryX=0.5000;" edge="1" parent="1" source="ul" target="dm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge9" value="realized by" style="fontFamily=Helvetica;html=1;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#4c2f7a;fontColor=#4c2f7a;exitX=1;exitY=0.5000;entryX=0;entryY=1.3152;" edge="1" parent="1" source="dm" target="mdd"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge10" value="needs" style="fontFamily=Helvetica;html=1;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#4c2f7a;fontColor=#4c2f7a;exitX=1;exitY=0.5000;entryX=0;entryY=0.5000;" edge="1" parent="1" source="mdd" target="hands"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="band2" value="" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#f6fbf5;strokeColor=#5fa35a;arcSize=2;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="577" width="3055" height="517" as="geometry"/></mxCell><mxCell id="tile2" value="&lt;div style=&quot;font-size:54px;font-weight:bold;opacity:0.9&quot;&gt;2&lt;/div&gt;&lt;div style=&quot;font-size:21px;font-weight:bold;margin-top:4px&quot;&gt;Distill the Problem Space&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-style:italic;margin-top:10px&quot;&gt;Which parts of the business matter most?&lt;/div&gt;&lt;div style=&quot;font-size:12px;margin-top:14px;text-align:left&quot;&gt;• Split the domain into subdomains&lt;br&gt;• Invest where you compete&lt;br&gt;• Buy or reuse the rest&lt;/div&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#5fa35a;strokeColor=#5fa35a;fontColor=#ffffff;arcSize=4;spacing=18;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="577" width="300" height="517" as="geometry"/></mxCell><mxCell id="domain" value="&lt;b style=&quot;font-size:14px&quot;&gt;Domain&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;The sphere of knowledge and activity the business operates in&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4e4;strokeColor=#5fa35a;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="400" y="807" width="240" height="92" as="geometry"/></mxCell><mxCell id="sub" value="&lt;b style=&quot;font-size:14px&quot;&gt;Subdomains&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Distinct, cohesive areas of the overall business problem&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4e4;strokeColor=#5fa35a;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="745" y="807" width="240" height="92" as="geometry"/></mxCell><mxCell id="fTypes" value="&lt;b&gt;Subdomain Types&lt;/b&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5fa35a;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;fontSize=13;fontColor=#2f6b2b;arcSize=5;" vertex="1" parent="1"><mxGeometry x="1072" y="623" width="276" height="444" as="geometry"/></mxCell><mxCell id="core" value="&lt;b style=&quot;font-size:14px&quot;&gt;Core Domain&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Competitive advantage → build in-house, best people, full DDD&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4e4;strokeColor=#5fa35a;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="1090" y="657" width="240" height="92" as="geometry"/></mxCell><mxCell id="supp" value="&lt;b style=&quot;font-size:14px&quot;&gt;Supporting Subdomain&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Specific to the business but not a differentiator → keep simple&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4e4;strokeColor=#5fa35a;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="1090" y="807" width="240" height="92" as="geometry"/></mxCell><mxCell id="gen" value="&lt;b style=&quot;font-size:14px&quot;&gt;Generic Subdomain&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Solved problem (auth, billing…) → buy, SaaS or open source&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4e4;strokeColor=#5fa35a;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="1090" y="957" width="240" height="92" as="geometry"/></mxCell><mxCell id="distill" value="&lt;b style=&quot;font-size:14px&quot;&gt;Distillation&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Separate the core from everything else so effort goes there&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4e4;strokeColor=#5fa35a;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="1435" y="657" width="240" height="92" as="geometry"/></mxCell><mxCell id="fDist" value="&lt;b&gt;Distillation Techniques&lt;/b&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5fa35a;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;fontSize=13;fontColor=#2f6b2b;arcSize=5;" vertex="1" parent="1"><mxGeometry x="1762" y="623" width="621" height="294" as="geometry"/></mxCell><mxCell id="dvs" value="&lt;b style=&quot;font-size:14px&quot;&gt;Domain Vision Statement&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;A short statement of the core domain&amp;#x27;s value&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4e4;strokeColor=#5fa35a;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="1780" y="657" width="240" height="92" as="geometry"/></mxCell><mxCell id="hcore" value="&lt;b style=&quot;font-size:14px&quot;&gt;Highlighted Core&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Flag core elements so everyone can see them&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4e4;strokeColor=#5fa35a;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="2125" y="657" width="240" height="92" as="geometry"/></mxCell><mxCell id="score" value="&lt;b style=&quot;font-size:14px&quot;&gt;Segregated Core&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Refactor core concepts apart from supporting code&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4e4;strokeColor=#5fa35a;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="1780" y="807" width="240" height="92" as="geometry"/></mxCell><mxCell id="cmech" value="&lt;b style=&quot;font-size:14px&quot;&gt;Cohesive Mechanisms&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Pull generic computations out into frameworks&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4e4;strokeColor=#5fa35a;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="2125" y="807" width="240" height="92" as="geometry"/></mxCell><mxCell id="fTools" value="&lt;b&gt;Strategic Analysis Tools&lt;/b&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5fa35a;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;fontSize=13;fontColor=#2f6b2b;arcSize=5;" vertex="1" parent="1"><mxGeometry x="2452" y="623" width="621" height="294" as="geometry"/></mxCell><mxCell id="cdc" value="&lt;b style=&quot;font-size:14px&quot;&gt;Core Domain Charts&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Plot subdomains by complexity and differentiation&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4e4;strokeColor=#5fa35a;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="2470" y="657" width="240" height="92" as="geometry"/></mxCell><mxCell id="wardley" value="&lt;b style=&quot;font-size:14px&quot;&gt;Wardley Mapping&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Value chain vs evolution → build, buy or outsource&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4e4;strokeColor=#5fa35a;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="2815" y="657" width="240" height="92" as="geometry"/></mxCell><mxCell id="pam" value="&lt;b style=&quot;font-size:14px&quot;&gt;Purpose Alignment Model&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Differentiating vs mission-critical activities&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4e4;strokeColor=#5fa35a;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="2470" y="807" width="240" height="92" as="geometry"/></mxCell><mxCell id="bmc" value="&lt;b style=&quot;font-size:14px&quot;&gt;Business Model Canvas&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;How the organization creates and captures value&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4e4;strokeColor=#5fa35a;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="2815" y="807" width="240" height="92" as="geometry"/></mxCell><mxCell id="edge11" value="decomposed into" style="fontFamily=Helvetica;html=1;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#2f6b2b;fontColor=#2f6b2b;exitX=1;exitY=0.5000;entryX=0;entryY=0.5000;" edge="1" parent="1" source="domain" target="sub"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge12" value="classified as" style="fontFamily=Helvetica;html=1;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#2f6b2b;fontColor=#2f6b2b;exitX=1;exitY=0.5000;entryX=0;entryY=0.5180;" edge="1" parent="1" source="sub" target="fTypes"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge13" value="sharpened by" style="fontFamily=Helvetica;html=1;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#2f6b2b;fontColor=#2f6b2b;exitX=1;exitY=0.5000;entryX=0;entryY=0.5000;" edge="1" parent="1" source="core" target="distill"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge14" value="through" style="fontFamily=Helvetica;html=1;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#2f6b2b;fontColor=#2f6b2b;exitX=1;exitY=0.5000;entryX=0;entryY=0.2721;" edge="1" parent="1" source="distill" target="fDist"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge15" value="help classify" style="fontFamily=Helvetica;html=1;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;strokeColor=#2f6b2b;fontColor=#2f6b2b;exitX=0.5;exitY=1;entryX=1;entryY=0.8559;" edge="1" parent="1" source="fTools" target="fTypes"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2762.5" y="1003.0"/></Array></mxGeometry></mxCell><mxCell id="band3" value="" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f9fe;strokeColor=#4f86c6;arcSize=2;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="1164" width="3055" height="517" as="geometry"/></mxCell><mxCell id="tile3" value="&lt;div style=&quot;font-size:54px;font-weight:bold;opacity:0.9&quot;&gt;3&lt;/div&gt;&lt;div style=&quot;font-size:21px;font-weight:bold;margin-top:4px&quot;&gt;Design the Solution (Strategic Design)&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-style:italic;margin-top:10px&quot;&gt;Where are the model boundaries, and how do they relate?&lt;/div&gt;&lt;div style=&quot;font-size:12px;margin-top:14px;text-align:left&quot;&gt;• Draw explicit boundaries&lt;br&gt;• One model, one language, one team per context&lt;br&gt;• Make every relationship deliberate&lt;/div&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#4f86c6;strokeColor=#4f86c6;fontColor=#ffffff;arcSize=4;spacing=18;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1164" width="300" height="517" as="geometry"/></mxCell><mxCell id="ulCtx" value="&lt;b style=&quot;font-size:14px&quot;&gt;Context-Specific Language&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Each term has exactly one meaning inside its context&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#e3eefb;strokeColor=#4f86c6;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="400" y="1244" width="240" height="92" as="geometry"/></mxCell><mxCell id="bc" value="&lt;b style=&quot;font-size:14px&quot;&gt;Bounded Context&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Explicit boundary within which one model is defined and consistent&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#e3eefb;strokeColor=#4f86c6;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="400" y="1394" width="240" height="92" as="geometry"/></mxCell><mxCell id="team" value="&lt;b style=&quot;font-size:14px&quot;&gt;Team Ownership&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;One team per context; boundaries follow Conway&amp;#x27;s Law&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#e3eefb;strokeColor=#4f86c6;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="400" y="1544" width="240" height="92" as="geometry"/></mxCell><mxCell id="cmap" value="&lt;b style=&quot;font-size:14px&quot;&gt;Context Map&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Shows every context and how they relate &amp;amp; integrate&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#e3eefb;strokeColor=#4f86c6;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="745" y="1394" width="240" height="92" as="geometry"/></mxCell><mxCell id="bcc" value="&lt;b style=&quot;font-size:14px&quot;&gt;Bounded Context Canvas&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Documents purpose, language, inbound &amp;amp; outbound messages&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#e3eefb;strokeColor=#4f86c6;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="745" y="1544" width="240" height="92" as="geometry"/></mxCell><mxCell id="fPatterns" value="&lt;b&gt;Context Mapping Patterns — how two contexts relate&lt;/b&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#4f86c6;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;fontSize=13;fontColor=#22508a;arcSize=3;" vertex="1" parent="1"><mxGeometry x="1056" y="1180" width="1688" height="340" as="geometry"/></mxCell><mxCell id="fCollab" value="&lt;b&gt;Collaborative&lt;/b&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4f86c6;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;fontSize=13;fontColor=#22508a;arcSize=5;" vertex="1" parent="1"><mxGeometry x="1072" y="1210" width="276" height="294" as="geometry"/></mxCell><mxCell id="partner" value="&lt;b style=&quot;font-size:14px&quot;&gt;Partnership&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Two teams succeed or fail together and plan jointly&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#e3eefb;strokeColor=#4f86c6;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="1090" y="1244" width="240" height="92" as="geometry"/></mxCell><mxCell id="sk" value="&lt;b style=&quot;font-size:14px&quot;&gt;Shared Kernel&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;A small, explicitly shared part of the model&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#e3eefb;strokeColor=#4f86c6;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="1090" y="1394" width="240" height="92" as="geometry"/></mxCell><mxCell id="fUD" value="&lt;b&gt;Upstream → Downstream&lt;/b&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4f86c6;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;fontSize=13;fontColor=#22508a;arcSize=5;" vertex="1" parent="1"><mxGeometry x="1417" y="1210" width="966" height="294" as="geometry"/></mxCell><mxCell id="cs" value="&lt;b style=&quot;font-size:14px&quot;&gt;Customer / Supplier&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Upstream plans its work around downstream needs&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#e3eefb;strokeColor=#4f86c6;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="1435" y="1244" width="240" height="92" as="geometry"/></mxCell><mxCell id="conf" value="&lt;b style=&quot;font-size:14px&quot;&gt;Conformist&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Downstream simply adopts the upstream model&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#e3eefb;strokeColor=#4f86c6;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="1780" y="1244" width="240" height="92" as="geometry"/></mxCell><mxCell id="acl" value="&lt;b style=&quot;font-size:14px&quot;&gt;Anticorruption Layer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Downstream translates to protect its own model&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#e3eefb;strokeColor=#4f86c6;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="2125" y="1244" width="240" height="92" as="geometry"/></mxCell><mxCell id="ohs" value="&lt;b style=&quot;font-size:14px&quot;&gt;Open Host Service&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Upstream exposes a well-defined public protocol / API&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#e3eefb;strokeColor=#4f86c6;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="1435" y="1394" width="240" height="92" as="geometry"/></mxCell><mxCell id="pl" value="&lt;b style=&quot;font-size:14px&quot;&gt;Published Language&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Documented exchange format, e.g. a shared schema&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#e3eefb;strokeColor=#4f86c6;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="1780" y="1394" width="240" height="92" as="geometry"/></mxCell><mxCell id="ud" value="&lt;b style=&quot;font-size:14px&quot;&gt;Upstream / Downstream&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Upstream changes affect downstream, never the reverse&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#e3eefb;strokeColor=#4f86c6;strokeWidth=1.5;arcSize=14;spacing=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="2125" y="1394" width="240" height="92" as="geometry"/></mxCell><mxCell id="fIndep" value="&lt;b&gt;Independent&lt;/b&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4f86c6;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;fontSize=13;fontColor=#22508a;arcSize=5;" vertex="1" parent="1"><mxGeometry x="2452" y="1210" width="276" height="294" as="geometry"/></mxCell><mxCell id="sep" value="&lt;b style=&quot;font-size:14px&quot;&gt;Separate Ways&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;No integration at all; each context solves it alone&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#e3eefb;strokeColor=#4f86c6;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="2470" y="1244" width="240" height="92" as="geometry"/></mxCell><mxCell id="bbom" value="&lt;b style=&quot;font-size:14px&quot;&gt;Big Ball of Mud&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Tangled legacy area: draw a boundary and quarantine it&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#e3eefb;strokeColor=#4f86c6;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="2470" y="1394" width="240" height="92" as="geometry"/></mxCell><mxCell id="integrity" value="&lt;b style=&quot;font-size:14px&quot;&gt;Model Integrity&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Concepts never leak across boundaries untranslated&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#e3eefb;strokeColor=#4f86c6;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="2815" y="1319.0" width="240" height="92" as="geometry"/></mxCell><mxCell id="edge16" value="has its own" style="fontFamily=Helvetica;html=1;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#22508a;fontColor=#22508a;exitY=0;exitX=0.5000;entryY=1;entryX=0.5000;" edge="1" parent="1" source="bc" target="ulCtx"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge17" value="owned by" style="fontFamily=Helvetica;html=1;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#22508a;fontColor=#22508a;exitY=1;exitX=0.5000;entryY=0;entryX=0.5000;" edge="1" parent="1" source="bc" target="team"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge18" value="related in" style="fontFamily=Helvetica;html=1;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#22508a;fontColor=#22508a;exitX=1;exitY=0.5000;entryX=0;entryY=0.5000;" edge="1" parent="1" source="bc" target="cmap"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge19" value="documented in" style="fontFamily=Helvetica;html=1;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#22508a;fontColor=#22508a;" edge="1" parent="1" source="bc" target="bcc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge20" value="uses" style="fontFamily=Helvetica;html=1;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#22508a;fontColor=#22508a;exitX=1;exitY=0.5000;entryX=0;entryY=0.7647;" edge="1" parent="1" source="cmap" target="fPatterns"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge21" value="may provide" style="fontFamily=Helvetica;html=1;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#22508a;fontColor=#22508a;exitY=1;exitX=0.5000;entryY=0;entryX=0.5000;" edge="1" parent="1" source="cs" target="ohs"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge22" value="speaks" style="fontFamily=Helvetica;html=1;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#22508a;fontColor=#22508a;exitX=1;exitY=0.5000;entryX=0;entryY=0.5000;" edge="1" parent="1" source="ohs" target="pl"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge23" value="alternative to" style="fontFamily=Helvetica;html=1;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#22508a;fontColor=#22508a;exitX=0;exitY=0.5000;entryX=1;entryY=0.5000;" edge="1" parent="1" source="acl" target="conf"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge24" value="preserve" style="fontFamily=Helvetica;html=1;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#22508a;fontColor=#22508a;exitX=1;exitY=0.5441;entryX=0;entryY=0.5000;" edge="1" parent="1" source="fPatterns" target="integrity"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="band4" value="" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf2;strokeColor=#e0962b;arcSize=2;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="1751" width="3055" height="517" as="geometry"/></mxCell><mxCell id="tile4" value="&lt;div style=&quot;font-size:54px;font-weight:bold;opacity:0.9&quot;&gt;4&lt;/div&gt;&lt;div style=&quot;font-size:21px;font-weight:bold;margin-top:4px&quot;&gt;Model Inside a Context (Tactical Design)&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-style:italic;margin-top:10px&quot;&gt;How do we express the model in code?&lt;/div&gt;&lt;div style=&quot;font-size:12px;margin-top:14px;text-align:left&quot;&gt;• Rich behavior, not anemic data&lt;br&gt;• Protect invariants inside aggregates&lt;br&gt;• Make implicit concepts explicit&lt;/div&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#e0962b;strokeColor=#e0962b;fontColor=#ffffff;arcSize=4;spacing=18;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1751" width="300" height="517" as="geometry"/></mxCell><mxCell id="appSvc" value="&lt;b style=&quot;font-size:14px&quot;&gt;Application Service&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Orchestrates one use case; thin, holds no business rules&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#fdefd9;strokeColor=#e0962b;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="400" y="1906.0" width="240" height="92" as="geometry"/></mxCell><mxCell id="module" value="&lt;b style=&quot;font-size:14px&quot;&gt;Module&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Groups cohesive concepts; named in the Ubiquitous Language&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#fdefd9;strokeColor=#e0962b;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="400" y="2131" width="240" height="92" as="geometry"/></mxCell><mxCell id="factory" value="&lt;b style=&quot;font-size:14px&quot;&gt;Factory&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Encapsulates complex creation of valid aggregates&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#fdefd9;strokeColor=#e0962b;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="745" y="1831" width="240" height="92" as="geometry"/></mxCell><mxCell id="repo" value="&lt;b style=&quot;font-size:14px&quot;&gt;Repository&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Collection-like access to load and save whole aggregates&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#fdefd9;strokeColor=#e0962b;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="745" y="1981" width="240" height="92" as="geometry"/></mxCell><mxCell id="fAgg" value="&lt;b&gt;Aggregate — the transactional consistency boundary&lt;/b&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e0962b;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;fontSize=13;fontColor=#8a5208;arcSize=5;" vertex="1" parent="1"><mxGeometry x="1072" y="1797" width="966" height="294" as="geometry"/></mxCell><mxCell id="ar" value="&lt;b style=&quot;font-size:14px&quot;&gt;Aggregate Root&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Single entry point; every change goes through it&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#fdefd9;strokeColor=#e0962b;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="1090" y="1831" width="240" height="92" as="geometry"/></mxCell><mxCell id="entity" value="&lt;b style=&quot;font-size:14px&quot;&gt;Entity&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Defined by an identity that persists through change&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#fdefd9;strokeColor=#e0962b;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="1435" y="1831" width="240" height="92" as="geometry"/></mxCell><mxCell id="vo" value="&lt;b style=&quot;font-size:14px&quot;&gt;Value Object&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Defined by its attributes; immutable, compared by value&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#fdefd9;strokeColor=#e0962b;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="1780" y="1831" width="240" height="92" as="geometry"/></mxCell><mxCell id="inv" value="&lt;b style=&quot;font-size:14px&quot;&gt;Invariants&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Business rules that must be true after every change&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#fdefd9;strokeColor=#e0962b;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="1090" y="1981" width="240" height="92" as="geometry"/></mxCell><mxCell id="rules" value="&lt;b style=&quot;font-size:14px&quot;&gt;Aggregate Design Rules&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Keep them small · Reference other aggregates by ID · One aggregate per transaction · Eventual consistency between aggregates&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#fdefd9;strokeColor=#e0962b;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="1435" y="1981" width="585" height="92" as="geometry"/></mxCell><mxCell id="devent" value="&lt;b style=&quot;font-size:14px&quot;&gt;Domain Event&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Something meaningful that happened, named in the past tense&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#fdefd9;strokeColor=#e0962b;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="1435" y="2131" width="240" height="92" as="geometry"/></mxCell><mxCell id="policy" value="&lt;b style=&quot;font-size:14px&quot;&gt;Policy / Event Handler&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Reacts to events: “whenever X happens, do Y”&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#fdefd9;strokeColor=#e0962b;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="1780" y="2131" width="240" height="92" as="geometry"/></mxCell><mxCell id="dsvc" value="&lt;b style=&quot;font-size:14px&quot;&gt;Domain Service&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Stateless domain operation that fits no single entity&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#fdefd9;strokeColor=#e0962b;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="2125" y="1831" width="240" height="92" as="geometry"/></mxCell><mxCell id="spec" value="&lt;b style=&quot;font-size:14px&quot;&gt;Specification&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Reusable, combinable business-rule predicate&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#fdefd9;strokeColor=#e0962b;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="2125" y="1981" width="240" height="92" as="geometry"/></mxCell><mxCell id="supple" value="&lt;b style=&quot;font-size:15px&quot;&gt;Supple Design&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#4b5563&quot;&gt;Design that is a pleasure to change&lt;/span&gt;&lt;ul style=&quot;font-size:14px;margin:12px 0 0 0;padding-left:20px;text-align:left;line-height:1.9&quot;&gt;&lt;li&gt;Intention-revealing interfaces&lt;/li&gt;&lt;li&gt;Side-effect-free functions&lt;/li&gt;&lt;li&gt;Assertions&lt;/li&gt;&lt;li&gt;Conceptual contours&lt;/li&gt;&lt;li&gt;Standalone classes&lt;/li&gt;&lt;li&gt;Closure of operations&lt;/li&gt;&lt;li&gt;Make implicit concepts explicit&lt;/li&gt;&lt;li&gt;Rich model, not anemic data holders&lt;/li&gt;&lt;/ul&gt;" style="fontFamily=Helvetica;shape=note;whiteSpace=wrap;html=1;size=22;fillColor=#fdefd9;strokeColor=#e0962b;strokeWidth=1.5;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="2470" y="1797" width="585" height="426" as="geometry"/></mxCell><mxCell id="edge25" value="creates via" style="fontFamily=Helvetica;html=1;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#8a5208;fontColor=#8a5208;exitX=1;exitY=0.5000;entryX=0;entryY=1.3152;" edge="1" parent="1" source="appSvc" target="factory"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge26" value="loads / saves via" style="fontFamily=Helvetica;html=1;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;s