try relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge32" value="emits" style="fontFamily=Helvetica;html=1;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#8a5208;fontColor=#8a5208;exitY=1;exitX=0.5000;entryY=0;entryX=0.5000;" edge="1" parent="1" source="fAgg" target="devent"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge33" value="triggers" style="fontFamily=Helvetica;html=1;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#8a5208;fontColor=#8a5208;exitX=1;exitY=0.5000;entryX=0;entryY=0.5000;" edge="1" parent="1" source="devent" target="policy"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge34" value="coordinates" style="fontFamily=Helvetica;html=1;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#8a5208;fontColor=#8a5208;exitX=0;exitY=0.5000;entryX=1;entryY=0.2721;" edge="1" parent="1" source="dsvc" target="fAgg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge35" value="checks rules" style="fontFamily=Helvetica;html=1;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#8a5208;fontColor=#8a5208;exitX=0;exitY=0.5000;entryX=1;entryY=0.7823;" edge="1" parent="1" source="spec" target="fAgg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge36" value="packages" style="fontFamily=Helvetica;html=1;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;strokeColor=#8a5208;fontColor=#8a5208;exitX=1;exitY=0.5;entryX=0.1429;entryY=1;" edge="1" parent="1" source="module" target="fAgg"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1210.0" y="2177.0"/></Array></mxGeometry></mxCell><mxCell id="band5" value="" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#fef6f6;strokeColor=#cf5c5c;arcSize=2;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="2338" width="3055" height="517" as="geometry"/></mxCell><mxCell id="tile5" value="&lt;div style=&quot;font-size:54px;font-weight:bold;opacity:0.9&quot;&gt;5&lt;/div&gt;&lt;div style=&quot;font-size:21px;font-weight:bold;margin-top:4px&quot;&gt;Build &amp;amp; Integrate (Architecture)&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-style:italic;margin-top:10px&quot;&gt;How do we run the model and connect the contexts?&lt;/div&gt;&lt;div style=&quot;font-size:12px;margin-top:14px;text-align:left&quot;&gt;• Keep the domain free of infrastructure&lt;br&gt;• Integrate through explicit contracts&lt;br&gt;• Choose deployment per context&lt;/div&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#cf5c5c;strokeColor=#cf5c5c;fontColor=#ffffff;arcSize=4;spacing=18;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="2338" width="300" height="517" as="geometry"/></mxCell><mxCell id="hexOuter" value="&lt;b style=&quot;font-size:13px&quot;&gt;Adapters &amp;amp; Infrastructure&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;UI · REST / gRPC · database · messaging&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#fbe4e4;strokeColor=#cf5c5c;strokeWidth=1.5;verticalAlign=top;arcSize=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="390" y="2378" width="605" height="432" as="geometry"/></mxCell><mxCell id="hexApp" value="&lt;b style=&quot;font-size:13px&quot;&gt;Application Layer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;use cases · ports (interfaces)&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#f7c9c9;strokeColor=#cf5c5c;strokeWidth=1.5;verticalAlign=top;arcSize=12;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="430" y="2440" width="525" height="308" as="geometry"/></mxCell><mxCell id="hexDomain" value="&lt;b style=&quot;font-size:15px;color:#ffffff&quot;&gt;Domain Model&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#ffffff&quot;&gt;aggregates · entities · value objects · domain services&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#cf5c5c;strokeColor=#8c2626;strokeWidth=1.5;arcSize=16;" vertex="1" parent="1"><mxGeometry x="480" y="2502" width="425" height="184" as="geometry"/></mxCell><mxCell id="hexCaption" value="&lt;i&gt;Hexagonal · Onion · Clean — dependencies point &lt;b&gt;inward&lt;/b&gt;; the domain depends on nothing&lt;/i&gt;" style="fontFamily=Helvetica;text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#8c2626;" vertex="1" parent="1"><mxGeometry x="390" y="2812" width="605" height="30" as="geometry"/></mxCell><mxCell id="cqrs" value="&lt;b style=&quot;font-size:14px&quot;&gt;CQRS&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Separate models for writes (commands) and reads (queries)&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#fbe4e4;strokeColor=#cf5c5c;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="1090" y="2418" width="240" height="92" as="geometry"/></mxCell><mxCell id="readm" value="&lt;b style=&quot;font-size:14px&quot;&gt;Read Models / Projections&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Query-optimized views built from changes or events&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#fbe4e4;strokeColor=#cf5c5c;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="1435" y="2418" width="240" height="92" as="geometry"/></mxCell><mxCell id="evs" value="&lt;b style=&quot;font-size:14px&quot;&gt;Event Sourcing&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Store state as an append-only sequence of domain events&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#fbe4e4;strokeColor=#cf5c5c;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="1090" y="2568" width="240" height="92" as="geometry"/></mxCell><mxCell id="estore" value="&lt;b style=&quot;font-size:14px&quot;&gt;Event Store&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Durable, ordered log of events per aggregate&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#fbe4e4;strokeColor=#cf5c5c;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="1435" y="2568" width="240" height="92" as="geometry"/></mxCell><mxCell id="mm" value="&lt;b style=&quot;font-size:14px&quot;&gt;Modular Monolith&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;One deployable; each bounded context is an isolated module&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#fbe4e4;strokeColor=#cf5c5c;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="1090" y="2718" width="240" height="92" as="geometry"/></mxCell><mxCell id="ms" value="&lt;b style=&quot;font-size:14px&quot;&gt;Microservices&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Contexts deployed and scaled independently&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#fbe4e4;strokeColor=#cf5c5c;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="1435" y="2718" width="240" height="92" as="geometry"/></mxCell><mxCell id="ie" value="&lt;b style=&quot;font-size:14px&quot;&gt;Integration Events&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Public, versioned events published to other contexts&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#fbe4e4;strokeColor=#cf5c5c;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="1780" y="2418" width="240" height="92" as="geometry"/></mxCell><mxCell id="eda" value="&lt;b style=&quot;font-size:14px&quot;&gt;Event-Driven Architecture&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Contexts collaborate by publishing &amp;amp; reacting to events&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#fbe4e4;strokeColor=#cf5c5c;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="1780" y="2568" width="240" height="92" as="geometry"/></mxCell><mxCell id="api" value="&lt;b style=&quot;font-size:14px&quot;&gt;APIs (Open Host Service)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Synchronous published contracts: REST, gRPC, GraphQL&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#fbe4e4;strokeColor=#cf5c5c;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="1780" y="2718" width="240" height="92" as="geometry"/></mxCell><mxCell id="outbox" value="&lt;b style=&quot;font-size:14px&quot;&gt;Transactional Outbox&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Save state and event atomically, then publish reliably&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#fbe4e4;strokeColor=#cf5c5c;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="2125" y="2418" width="240" height="92" as="geometry"/></mxCell><mxCell id="broker" value="&lt;b style=&quot;font-size:14px&quot;&gt;Message Broker&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Delivers messages asynchronously (Kafka, RabbitMQ, …)&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#fbe4e4;strokeColor=#cf5c5c;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="2470" y="2418" width="240" height="92" as="geometry"/></mxCell><mxCell id="saga" value="&lt;b style=&quot;font-size:14px&quot;&gt;Sagas / Process Managers&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Coordinate long-running workflows across contexts&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#fbe4e4;strokeColor=#cf5c5c;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="2470" y="2568" width="240" height="92" as="geometry"/></mxCell><mxCell id="acl2" value="&lt;b style=&quot;font-size:14px&quot;&gt;Translation at the Edge&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;ACLs and adapters map external models to your own&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#fbe4e4;strokeColor=#cf5c5c;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="2125" y="2718" width="240" height="92" as="geometry"/></mxCell><mxCell id="contract" value="&lt;b style=&quot;font-size:14px&quot;&gt;Consumer-Driven Contracts&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Tests that keep published contracts from breaking consumers&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#fbe4e4;strokeColor=#cf5c5c;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="2470" y="2718" width="240" height="92" as="geometry"/></mxCell><mxCell id="deploy" value="&lt;b style=&quot;font-size:14px&quot;&gt;Bounded Context = Unit of Autonomy&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;Owned, built, tested &amp;amp; deployed independently by one team&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#fbe4e4;strokeColor=#cf5c5c;strokeWidth=1.5;arcSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="2815" y="2493.0" width="240" height="92" as="geometry"/></mxCell><mxCell id="edge37" value=