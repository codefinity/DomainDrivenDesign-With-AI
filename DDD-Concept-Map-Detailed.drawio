dth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#8c2626;fontColor=#8c2626;exitY=0;exitX=0.5000;entryY=1;entryX=0.5000;" edge="1" parent="1" source="eda" target="ie"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge43" value="published via" style="fontFamily=Helvetica;html=1;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#8c2626;fontColor=#8c2626;exitX=1;exitY=0.5000;entryX=0;entryY=0.5000;" edge="1" parent="1" source="ie" target="outbox"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge44" value="relayed through" style="fontFamily=Helvetica;html=1;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#8c2626;fontColor=#8c2626;exitX=1;exitY=0.5000;entryX=0;entryY=0.5000;" edge="1" parent="1" source="outbox" target="broker"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge45" value="listen &amp; send via" style="fontFamily=Helvetica;html=1;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#8c2626;fontColor=#8c2626;exitY=0;exitX=0.5000;entryY=1;entryX=0.5000;" edge="1" parent="1" source="saga" target="broker"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge46" value="consumed through" style="fontFamily=Helvetica;html=1;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#8c2626;fontColor=#8c2626;exitX=1;exitY=0.5000;entryX=0;entryY=0.5000;" edge="1" parent="1" source="api" target="acl2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge47" value="verified by" style="fontFamily=Helvetica;html=1;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#8c2626;fontColor=#8c2626;exitX=1;exitY=0.5000;entryX=0;entryY=0.5000;" edge="1" parent="1" source="acl2" target="contract"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge48" value="decouples" style="fontFamily=Helvetica;html=1;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#8c2626;fontColor=#8c2626;exitX=1;exitY=0.5000;entryX=0;entryY=-0.3152;" edge="1" parent="1" source="broker" target="deploy"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge49" value="shared language &amp; first model" style="fontFamily=Helvetica;html=1;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#374151;strokeWidth=4;endArrow=block;endSize=10;fontColor=#111827;fontSize=12;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;labelBackgroundColor=#ffffff;labelPosition=right;align=left;spacingLeft=14;" edge="1" parent="1" source="tile1" target="tile2"><mxGeometry relative="1" x="0" as="geometry"></mxGeometry></mxCell><mxCell id="edge50" value="prioritized subdomains" style="fontFamily=Helvetica;html=1;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#374151;strokeWidth=4;endArrow=block;endSize=10;fontColor=#111827;fontSize=12;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;labelBackgroundColor=#ffffff;labelPosition=right;align=left;spacingLeft=14;" edge="1" parent="1" source="tile2" target="tile3"><mxGeometry relative="1" x="0" as="geometry"></mxGeometry></mxCell><mxCell id="edge51" value="one model per bounded context" style="fontFamily=Helvetica;html=1;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#374151;strokeWidth=4;endArrow=block;endSize=10;fontColor=#111827;fontSize=12;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;labelBackgroundColor=#ffffff;labelPosition=right;align=left;spacingLeft=14;" edge="1" parent="1" source="tile3" target="tile4"><mxGeometry relative="1" x="0" as="geometry"></mxGeometry></mxCell><mxCell id="edge52" value="domain model in code" style="fontFamily=Helvetica;html=1;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#374151;strokeWidth=4;endArrow=block;endSize=10;fontColor=#111827;fontSize=12;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;labelBackgroundColor=#ffffff;labelPosition=right;align=left;spacingLeft=14;" edge="1" parent="1" source="tile4" target="tile5"><mxGeometry relative="1" x="0" as="geometry"></mxGeometry></mxCell><mxCell id="edge53" value="Refactor toward&lt;br&gt;deeper insight&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;new understanding&lt;br&gt;reshapes the model&lt;br&gt;and its boundaries&lt;/span&gt;" style="fontFamily=Helvetica;html=1;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;strokeColor=#374151;strokeWidth=3;dashed=1;endArrow=block;endSize=10;fontColor=#111827;fontSize=12;fontStyle=1;exitX=1;exitY=0.5;entryX=1;entryY=0.5;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="band5" target="band1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3140" y="2596.5"/><mxPoint x="3140" y="323.5"/></Array></mxGeometry></mxCell><mxCell id="keyTitle" value="&lt;b style=&quot;font-size:22px&quot;&gt;Key Ideas to Remember&lt;/b&gt;" style="fontFamily=Helvetica;text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="2935" width="600" height="36" as="geometry"/></mxCell><mxCell id="idea0" value="&lt;b style=&quot;font-size:14px&quot;&gt;1. Focus on the core&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#4b5563&quot;&gt;Spend your best effort where the business competes.&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f4f6;strokeColor=#9ca3af;arcSize=12;spacing=10;" vertex="1" parent="1"><mxGeometry x="40.0" y="2981" width="489.1666666666667" height="76" as="geometry"/></mxCell><mxCell id="idea1" value="&lt;b style=&quot;font-size:14px&quot;&gt;2. Model with experts&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#4b5563&quot;&gt;Developers and domain experts learn together, continuously.&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f4f6;strokeColor=#9ca3af;arcSize=12;spacing=10;" vertex="1" parent="1"><mxGeometry x="553.1666666666667" y="2981" width="489.1666666666667" height="76" as="geometry"/></mxCell><mxCell id="idea2" value="&lt;b style=&quot;font-size:14px&quot;&gt;3. Speak one language&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#4b5563&quot;&gt;The same terms in conversations, documents and code.&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f4f6;strokeColor=#9ca3af;arcSize=12;spacing=10;" vertex="1" parent="1"><mxGeometry x="1066.3333333333335" y="2981" width="489.1666666666667" height="76" as="geometry"/></mxCell><mxCell id="idea3" value="&lt;b style=&quot;font-size:14px&quot;&gt;4. Make boundaries explicit&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#4b5563&quot;&gt;Each model is valid only inside its bounded context.&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f4f6;strokeColor=#9ca3af;arcSize=12;spacing=10;" vertex="1" parent="1"><mxGeometry x="1579.5000000000002" y="2981" width="489.1666666666667" height="76" as="geometry"/></mxCell><mxCell id="idea4" value="&lt;b style=&quot;font-size:14px&quot;&gt;5. Keep model &amp;amp; code aligned&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#4b5563&quot;&gt;If the code drifts from the model, the model is lost.&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f4f6;strokeColor=#9ca3af;arcSize=12;spacing=10;" vertex="1" parent="1"><mxGeometry x="2092.666666666667" y="2981" width="489.1666666666667" height="76" as="geometry"/></mxCell><mxCell id="idea5" value="&lt;b style=&quot;font-size:14px&quot;&gt;6. Evolve deliberately&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#4b5563&quot;&gt;Refactor toward deeper insight as understanding grows.&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f4f6;strokeColor=#9ca3af;arcSize=12;spacing=10;" vertex="1" parent="1"><mxGeometry x="2605.833333333334" y="2981" width="489.1666666666667" height="76" as="geometry"/></mxCell><mxCell id="legendBox" value="" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;arcSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="3085" width="1180" height="64" as="geometry"/></mxCell><mxCell id="legendTitle" value="&lt;b&gt;Legend&lt;/b&gt;" style="fontFamily=Helvetica;text;html=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="54" y="3103" width="70" height="28" as="geometry"/></mxCell><mxCell id="lgCard" value="&lt;b style=&quot;font-size:14px&quot;&gt;Concept&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4b5563&quot;&gt;short definition&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f4f6;strokeColor=#6b7280;arcSize=14;" vertex="1" parent="1"><mxGeometry x="130" y="3095" width="150" height="44" as="geometry"/></mxCell><mxCell id="lgFrame" value="&lt;b&gt;Group&lt;/b&gt; of related concepts" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b7280;dashed=1;dashPattern=6 4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="3095" width="200" height="44" as="geometry"/></mxCell><mxCell id="lgA" value="" style="fontFamily=Helvetica;text;html=1;" vertex="1" parent="1"><mxGeometry x="530" y="3117" width="1" height="1" as="geometry"/></mxCell><mxCell id="lgB" value="" style="fontFamily=Helvetica;text;html=1;" verte