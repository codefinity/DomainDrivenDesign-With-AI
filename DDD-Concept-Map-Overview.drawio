<mxfile host="drawio" version="29.3.6"><diagram name="DDD Overview" id="ddd-overview"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1890" pageHeight="1176" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b style=&quot;font-size:36px&quot;&gt;Domain-Driven Design&lt;/b&gt;&lt;span style=&quot;font-size:22px;color:#6b7280&quot;&gt;  ·  the big picture&lt;/span&gt;" style="fontFamily=Helvetica;text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="22" width="1770" height="50" as="geometry"/></mxCell><mxCell id="subtitle" value="Build software around a deep, shared understanding of the business — read left to right, from the business problem to running code." style="fontFamily=Helvetica;text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="60" y="74" width="1770" height="28" as="geometry"/></mxCell><mxCell id="colp" value="" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5fa35a;dashed=1;dashPattern=6 4;arcSize=4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="46" y="166" width="388" height="690" as="geometry"/></mxCell><mxCell id="hp" value="&lt;table style=&quot;width:100%&quot;&gt;&lt;tr&gt;&lt;td style=&quot;font-size:46px;font-weight:bold;width:56px;vertical-align:middle&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;text-align:left;vertical-align:middle&quot;&gt;&lt;div style=&quot;font-size:22px;font-weight:bold&quot;&gt;Problem Space&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-style:italic;margin-top:4px&quot;&gt;What problem is the business solving?&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#5fa35a;strokeColor=#5fa35a;fontColor=#ffffff;arcSize=12;spacing=12;" vertex="1" parent="1"><mxGeometry x="60" y="180" width="360" height="104" as="geometry"/></mxCell><mxCell id="p0" value="&lt;b style=&quot;font-size:16px&quot;&gt;Domain&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#4b5563&quot;&gt;The business area and the knowledge behind it&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4e4;strokeColor=#5fa35a;strokeWidth=1.5;arcSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="360" height="86" as="geometry"/></mxCell><mxCell id="p1" value="&lt;b style=&quot;font-size:16px&quot;&gt;Subdomains&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#4b5563&quot;&gt;Distinct areas that make up the business problem&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4e4;strokeColor=#5fa35a;strokeWidth=1.5;arcSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="468" width="360" height="86" as="geometry"/></mxCell><mxCell id="edge1" value="split into" style="fontFamily=Helvetica;html=1;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.5;strokeColor=#2f6b2b;fontColor=#2f6b2b;fontSize=12;fontStyle=2;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p0" target="p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2" value="&lt;b style=&quot;font-size:16px&quot;&gt;Core · Supporting · Generic&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#4b5563&quot;&gt;Classify each subdomain by how much it differentiates&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4e4;strokeColor=#5fa35a;strokeWidth=1.5;arcSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="606" width="360" height="86" as="geometry"/></mxCell><mxCell id="edge2" value="classified as" style="fontFamily=Helvetica;html=1;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.5;strokeColor=#2f6b2b;fontColor=#2f6b2b;fontSize=12;fontStyle=2;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3" value="&lt;b style=&quot;font-size:16px&quot;&gt;Focus on the Core Domain&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#4b5563&quot;&gt;Invest the best effort where the business competes&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4e4;strokeColor=#5fa35a;strokeWidth=1.5;arcSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="744" width="360" height="86" as="geometry"/></mxCell><mxCell id="edge3" value="prioritizes" style="fontFamily=Helvetica;html=1;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.5;strokeColor=#2f6b2b;fontColor=#2f6b2b;fontSize=12;fontStyle=2;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cols" value="" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4f86c6;dashed=1;dashPattern=6 4;arcSize=4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="516" y="166" width="388" height="690" as="geometry"/></mxCell><mxCell id="hs" value="&lt;table style=&quot;width:100%&quot;&gt;&lt;tr&gt;&lt;td style=&quot;font-size:46px;font-weight:bold;width:56px;vertical-align:middle&quot;&gt;2&lt;/td&gt;&lt;td style=&quot;text-align:left;vertical-align:middle&quot;&gt;&lt;div style=&quot;font-size:22px;font-weight:bold&quot;&gt;Strategic Design&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-style:italic;margin-top:4px&quot;&gt;Where are the model boundaries?&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#4f86c6;strokeColor=#4f86c6;fontColor=#ffffff;arcSize=12;spacing=12;" vertex="1" parent="1"><mxGeometry x="530" y="180" width="360" height="104" as="geometry"/></mxCell><mxCell id="s0" value="&lt;b style=&quot;font-size:16px&quot;&gt;Bounded Context&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#4b5563&quot;&gt;Explicit boundary in which one model and language apply&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#e3eefb;strokeColor=#4f86c6;strokeWidth=1.5;arcSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="530" y="330" width="360" height="86" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b style=&quot;font-size:16px&quot;&gt;Context Map&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#4b5563&quot;&gt;Shows all contexts and how they relate&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#e3eefb;strokeColor=#4f86c6;strokeWidth=1.5;arcSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="530" y="468" width="360" height="86" as="geometry"/></mxCell><mxCell id="edge4" value="related on a" style="fontFamily=Helvetica;html=1;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.5;strokeColor=#22508a;fontColor=#22508a;fontSize=12;fontStyle=2;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s0" target="s1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s2" value="&lt;b style=&quot;font-size:16px&quot;&gt;Relationship Patterns&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#4b5563&quot;&gt;Partnership, Customer/Supplier, ACL, Open Host, Shared Kernel…&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#e3eefb;strokeColor=#4f86c6;strokeWidth=1.5;arcSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="530" y="606" width="360" height="86" as="geometry"/></mxCell><mxCell id="edge5" value="described by" style="fontFamily=Helvetica;html=1;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.5;strokeColor=#22508a;fontColor=#22508a;fontSize=12;fontStyle=2;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s3" value="&lt;b style=&quot;font-size:16px&quot;&gt;Autonomous Teams&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#4b5563&quot;&gt;One team owns each context (Conway&amp;#x27;s Law)&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#e3eefb;strokeColor=#4f86c6;strokeWidth=1.5;arcSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="530" y="744" width="360" height="86" as="geometry"/></mxCell><mxCell id="edge6" value="enable" style="fontFamily=Helvetica;html=1;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.5;strokeColor=#22508a;fontColor=#22508a;fontSize=12;fontStyle=2;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="colt" value="" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e0962b;dashed=1;dashPattern=6 4;arcSize=4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="986" y="166" width="388" height="690" as="geometry"/></mxCell><mxCell id="ht" value="&lt;table style=&quot;width:100%&quot;&gt;&lt;tr&gt;&lt;td style=&quot;font-size:46px;font-weight:bold;width:56px;vertical-align:middle&quot;&gt;3&lt;/td&gt;&lt;td style=&quot;text-align:left;vertical-align:middle&quot;&gt;&lt;div style=&quot;font-size:22px;font-weight:bold&quot;&gt;Tactical Design&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-style:italic;margin-top:4px&quot;&gt;How is the model built inside a context?&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#e0962b;strokeColor=#e0962b;fontColor=#ffffff;arcSize=12;spacing=12;" vertex="1" parent="1"><mxGeometry x="1000" y="180" width="360" height="104" as="geometry"/></mxCell><mxCell id="t0" value="&lt;b style=&quot;font-size:16px&quot;&gt;Aggregates&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#4b5563&quot;&gt;Consistency boundaries that protect business rules&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#fdefd9;strokeColor=#e0962b;strokeWidth=1.5;arcSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1000" y="330" width="360" height="86" as="geometry"/></mxCell><mxCell id="t1" value="&lt;b style=&quot;font-size:16px&quot;&gt;Entities &amp;amp; Value Objects&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#4b5563&quot;&gt;Things with identity, and immutable descriptive values&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#fdefd9;strokeColor=#e0962b;strokeWidth=1.5;arcSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1000" y="468" width="360" height="86" as="geometry"/></mxCell><mxCell id="edge7" value="built from" style="fontFamily=Helvetica;html=1;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.5;strokeColor=#8a5208;fontColor=#8a5208;fontSize=12;fontStyle=2;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="t0" target="t1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t2" value="&lt;b style=&quot;font-size:16px&quot;&gt;Domain Events&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#4b5563&quot;&gt;Meaningful things that happened in the domain&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#fdefd9;strokeColor=#e0962b;strokeWidth=1.5;arcSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1000" y="606" width="360" height="86" as="geometry"/></mxCell><mxCell id="edge8" value="changes raise" style="fontFamily=Helvetica;html=1;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.5;strokeColor=#8a5208;fontColor=#8a5208;fontSize=12;fontStyle=2;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="t1" target="t2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t3" value="&lt;b style=&quot;font-size:16px&quot;&gt;Repositories · Factories · Services&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#4b5563&quot;&gt;Create, store and coordinate aggregates&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#fdefd9;strokeColor=#e0962b;strokeWidth=1.5;arcSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1000" y="744" width="360" height="86" as="geometry"/></mxCell><mxCell id="edge9" value="supported by" style="fontFamily=Helvetica;html=1;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.5;strokeColor=#8a5208;fontColor=#8a5208;fontSize=12;fontStyle=2;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="t2" target="t3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cola" value="" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cf5c5c;dashed=1;dashPattern=6 4;arcSize=4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1456" y="166" width="388" height="690" as="geometry"/></mxCell><mxCell id="ha" value="&lt;table style=&quot;width:100%&quot;&gt;&lt;tr&gt;&lt;td style=&quot;font-size:46px;font-weight:bold;width:56px;vertical-align:middle&quot;&gt;4&lt;/td&gt;&lt;td style=&quot;text-align:left;vertical-align:middle&quot;&gt;&lt;div style=&quot;font-size:22px;font-weight:bold&quot;&gt;Architecture&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-style:italic;margin-top:4px&quot;&gt;How does it run and integrate?&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#cf5c5c;strokeColor=#cf5c5c;fontColor=#ffffff;arcSize=12;spacing=12;" vertex="1" parent="1"><mxGeometry x="1470" y="180" width="360" height="104" as="geometry"/></mxCell><mxCell id="a0" value="&lt;b style=&quot;font-size:16px&quot;&gt;Hexagonal / Clean&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#4b5563&quot;&gt;Domain at the center, free of infrastructure&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#fbe4e4;strokeColor=#cf5c5c;strokeWidth=1.5;arcSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1470" y="330" width="360" height="86" as="geometry"/></mxCell><mxCell id="a1" value="&lt;b style=&quot;font-size:16px&quot;&gt;CQRS &amp;amp; Event Sourcing&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#4b5563&quot;&gt;Optional patterns for separate reads/writes and event history&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#fbe4e4;strokeColor=#cf5c5c;strokeWidth=1.5;arcSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1470" y="468" width="360" height="86" as="geometry"/></mxCell><mxCell id="edge10" value="can add" style="fontFamily=Helvetica;html=1;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.5;strokeColor=#8c2626;fontColor=#8c2626;fontSize=12;fontStyle=2;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="a0" target="a1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a2" value="&lt;b style=&quot;font-size:16px&quot;&gt;Event-Driven Integration&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#4b5563&quot;&gt;Contexts collaborate through published events and APIs&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#fbe4e4;strokeColor=#cf5c5c;strokeWidth=1.5;arcSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1470" y="606" width="360" height="86" as="geometry"/></mxCell><mxCell id="edge11" value="integrates via" style="fontFamily=Helvetica;html=1;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.5;strokeColor=#8c2626;fontColor=#8c2626;fontSize=12;fontStyle=2;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a3" value="&lt;b style=&quot;font-size:16px&quot;&gt;Modular Monolith or Microservices&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#4b5563&quot;&gt;Each bounded context is deployed as a module or service&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#fbe4e4;strokeColor=#cf5c5c;strokeWidth=1.5;arcSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1470" y="744" width="360" height="86" as="geometry"/></mxCell><mxCell id="edge12" value="deployed as" style="fontFamily=Helvetica;html=1;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.5;strokeColor=#8c2626;fontColor=#8c2626;fontSize=12;fontStyle=2;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge13" value="subdomains align&lt;br&gt;with contexts" style="fontFamily=Helvetica;html=1;rounded=1;strokeColor=#374151;strokeWidth=5;endArrow=block;endFill=1;endSize=9;fontSize=12;fontStyle=1;fontColor=#111827;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;spacingTop=6;" edge="1" parent="1" source="colp" target="cols"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge14" value="each context gets&lt;br&gt;its own model" style="fontFamily=Helvetica;html=1;rounded=1;strokeColor=#374151;strokeWidth=5;endArrow=block;endFill=1;endSize=9;fontSize=12;fontStyle=1;fontColor=#111827;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;spacingTop=6;" edge="1" parent="1" source="cols" target="colt"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge15" value="model runs&lt;br&gt;inside" style="fontFamily=Helvetica;html=1;rounded=1;strokeColor=#374151;strokeWidth=5;endArrow=block;endFill=1;endSize=9;fontSize=12;fontStyle=1;fontColor=#111827;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;spacingTop=6;" edge="1" parent="1" source="colt" target="cola"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge16" value="Continuous learning: refactor toward deeper insight — new understanding reshapes the model" style="fontFamily=Helvetica;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#6b7280;strokeWidth=2.5;dashed=1;endArrow=block;endFill=1;endSize=9;fontSize=13;fontStyle=3;fontColor=#374151;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="ha" target="hp"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1650.0" y="128"/><mxPoint x="240.0" y="128"/></Array></mxGeometry></mxCell><mxCell id="fTag" value="&lt;b style=&quot;font-size:13px;letter-spacing:2px&quot;&gt;FOUNDATIONS&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;underpin every stage&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#374151;strokeColor=#374151;fontColor=#ffffff;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="902" width="170" height="186" as="geometry"/></mxCell><mxCell id="ul" value="&lt;b style=&quot;font-size:18px&quot;&gt;Ubiquitous Language&lt;/b&gt;&lt;span style=&quot;font-size:14px;color:#4b5563&quot;&gt;  —  one shared vocabulary between experts and developers, used in conversations, documents, tests and code; each term means one thing within its bounded context.&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c5cc4;strokeWidth=1.5;arcSize=14;align=left;spacingLeft=20;spacingRight=20;" vertex="1" parent="1"><mxGeometry x="250" y="902" width="1580" height="86" as="geometry"/></mxCell><mxCell id="collab" value="&lt;b style=&quot;font-size:18px&quot;&gt;Collaborative Modeling&lt;/b&gt;&lt;span style=&quot;font-size:14px;color:#4b5563&quot;&gt;  —  domain experts and developers discover the domain together through Event Storming, Domain Storytelling and Example Mapping, producing the domain model.&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c5cc4;strokeWidth=1.5;arcSize=14;align=left;spacingLeft=20;spacingRight=20;" vertex="1" parent="1"><mxGeometry x="250" y="1002" width="1580" height="86" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;How to read:&lt;/b&gt;  numbered stages run left → right  ·  thin arrows read as sentences (&lt;i&gt;Aggregates → built from → Entities &amp;amp; Value Objects&lt;/i&gt;)  ·  the dashed loop shows that DDD is iterative" style="fontFamily=Helvetica;text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#4b5563;" vertex="1" parent="1"><mxGeometry x="60" y="1116" width="1770" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>